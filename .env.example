# =====================================================================
# SHIELD-LLM Security Gateway — Environment Configuration
# =====================================================================
# Copy this file to '.env' in the project root or backend directory.
# Defaults are pre-configured for local Ollama running on your Windows host.

# --- LLM Provider Selection ---
# Options: 'ollama' (default, local GPU-accelerated LLM) or 'openai' (cloud)
LLM_PROVIDER=ollama

# --- Local Ollama Configuration (Default: Gemma 3 1B) ---
# Running locally via Ollama API on your NVIDIA GTX 1650
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT=25.0
OLLAMA_MAX_TOKENS=256

# --- Cloud OpenAI Configuration (Optional Fallback) ---
# Used only if LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=15.0

# --- ML Model & Data Paths (Optional Overrides) ---
# Default classifier: Phase 5D (1.5% FPR)
# SHIELD_MODEL_DIR=ml/models/distilbert_phase5d

# Default semantic bank: Phase 5G sanitized dataset
# SHIELD_TRAIN_CSV=data/train_phase5g.csv
